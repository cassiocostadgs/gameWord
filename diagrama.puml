' ════════════════════════════════════════════════════════
'  DIAGRAMA 1 — Arquitetura de Componentes
' ════════════════════════════════════════════════════════
@startuml Arquitetura

title IA Crossword — Arquitetura de Componentes

!theme plain
skinparam defaultFontName Inter
skinparam defaultFontSize 12
skinparam backgroundColor #FDFBFF
skinparam ArrowColor #7C3AED
skinparam ArrowThickness 2
skinparam ArrowFontColor #5B21B6
skinparam ArrowFontSize 10

skinparam package {
  BorderColor #7C3AED
  BackgroundColor #F5F3FF
  FontColor #4C1D95
  FontStyle bold
  BorderThickness 2
}

skinparam rectangle {
  BorderColor #9F7AEA
  BackgroundColor #EDE9FE
  FontColor #3B0764
  RoundCorner 10
}

skinparam note {
  BorderColor #A78BFA
  BackgroundColor #FAF5FF
  FontColor #4C1D95
}

package "puzzleData.ts" as Data {
  rectangle "clues[ ]" as Clues
  rectangle "generateInitialGrid()" as GridGen
}

package "useCrossword.ts" as Logic {
  rectangle "Estado React" as State
  rectangle "Handlers" as Handlers
  rectangle "useEffect" as Effects
}

package "Crossword / index.tsx" as UI {
  rectangle "StatsBar" as Stats
  rectangle "Board  9 x 10" as Board
  rectangle "Modal Vitoria" as VictoryModal
}

rectangle "Cell.tsx" as CellComp
rectangle "Clues.tsx" as CluesComp

Data    -down->  Logic     : clues + grid inicial
Logic   -down->  UI        : estado + handlers
UI      -right-> CellComp  : 90 instancias
UI      -down->  CluesComp : pistas + navegacao

Handlers --> State   : setState
State    --> Effects : dispara

note right of Effects
  #1 Win Monitor
  #2 Timer interval
end note

@enduml

' ════════════════════════════════════════════════════════
'  DIAGRAMA 2 — Fluxo: Digitacao
' ════════════════════════════════════════════════════════
@startuml FluxoDigitacao

title IA Crossword — Fluxo: Digitacao de uma Letra

!theme plain
skinparam defaultFontName Inter
skinparam ArrowColor #7C3AED
skinparam ArrowThickness 1.5

skinparam participant {
  BorderColor #7C3AED
  BackgroundColor #F5F3FF
  FontColor #3B0764
}

skinparam actor {
  BorderColor #7C3AED
  BackgroundColor #EDE9FE
}

skinparam sequence {
  DividerBackgroundColor #EDE9FE
  DividerBorderColor #7C3AED
  GroupBorderColor #A78BFA
}

skinparam note {
  BackgroundColor #FAF5FF
  BorderColor #A78BFA
}

actor       "Usuario"      as User
participant "Cell.tsx"     as Cell
participant "index.tsx"    as UI
participant "useCrossword" as Hook
participant "React State"  as State
participant "useEffect"    as Effect

== Interacao ==
User  -> Cell  : digita letra
Cell  -> UI    : onChange(letra)
UI    -> Hook  : handleCellChange(row, col, letra)
activate Hook
Hook  -> Hook  : inicia timer
Hook  -> State : setGrid
Hook  -> State : setActiveCell
deactivate Hook

== Re-render ==
State -> UI   : re-render
UI    -> Cell : foco na proxima celula

== Verificacao de Vitoria ==
State  -> Effect : grid mudou
activate Effect
alt todas corretas
  Effect -> State : setIsCompleted(true)
  State  -> UI    : Modal de Vitoria
else incompleto
  Effect -> Effect : aguarda
end
deactivate Effect

@enduml

' ════════════════════════════════════════════════════════
'  DIAGRAMA 3 — Fluxo: Sistema de Dicas
' ════════════════════════════════════════════════════════
@startuml FluxoDica

title IA Crossword — Fluxo: Sistema de Dicas

!theme plain
skinparam defaultFontName Inter
skinparam ArrowColor #7C3AED
skinparam ArrowThickness 1.5

skinparam participant {
  BorderColor #7C3AED
  BackgroundColor #F5F3FF
  FontColor #3B0764
}

skinparam actor {
  BorderColor #7C3AED
  BackgroundColor #EDE9FE
}

skinparam sequence {
  DividerBackgroundColor #EDE9FE
  DividerBorderColor #7C3AED
  GroupBorderColor #A78BFA
}

skinparam note {
  BackgroundColor #FAF5FF
  BorderColor #A78BFA
}

actor       "Usuario"      as User
participant "index.tsx"    as UI
participant "useCrossword" as Hook
participant "React State"  as State

== Solicitacao ==
User -> UI   : clica Dica
UI   -> Hook : useHint()
activate Hook
Hook -> Hook : guard: hintsLeft > 0

== Selecao da Celula ==
alt palavra ativa tem celula nao resolvida
  Hook -> Hook : escolhe celula da palavra ativa
else palavra ja completa
  Hook -> Hook : escolhe celula aleatoria do grid
end

== Atualizacao ==
Hook -> State : hintsLeft - 1
Hook -> State : hintedCells + grid (revela letra)
deactivate Hook

State -> UI : re-render

note over UI
  Celula revelada = estilo amber (.hinted)
  Distinto do verde (.correct)
end note

@enduml

' ════════════════════════════════════════════════════════
'  DIAGRAMA 4 — Maquina de Estados
' ════════════════════════════════════════════════════════
@startuml EstadosJogo

title IA Crossword — Maquina de Estados

!theme plain
skinparam defaultFontName Inter
skinparam ArrowColor #7C3AED
skinparam ArrowThickness 2
skinparam ArrowFontColor #5B21B6

skinparam state {
  BorderColor #7C3AED
  BackgroundColor #F5F3FF
  FontColor #3B0764
  StartColor #7C3AED
  EndColor #5B21B6
  AttributeFontColor #6D28D9
}

skinparam note {
  BackgroundColor #FAF5FF
  BorderColor #A78BFA
}

[*] --> Inativo : inicializa

state Inativo : timer = 0\nhintsLeft = 3

state "Em Andamento" as EmAndamento : timer ativo\nhintsLeft 0 a 3

state Concluido : isCompleted = true\nmodal visivel

Inativo     --> EmAndamento : 1a letra / dica
EmAndamento --> EmAndamento : digita / navega / dica
EmAndamento --> Concluido   : todas as celulas corretas
Concluido   --> Inativo     : resetGame()

@enduml

' ════════════════════════════════════════════════════════
'  DIAGRAMA 5 — Estrutura de Dados
' ════════════════════════════════════════════════════════
@startuml EstruturaDados

title IA Crossword — Estrutura de Dados

!theme plain
skinparam defaultFontName Inter
skinparam ArrowColor #7C3AED
skinparam ArrowThickness 1.5

skinparam class {
  BorderColor #7C3AED
  BackgroundColor #F5F3FF
  FontColor #3B0764
  HeaderBackgroundColor #EDE9FE
  AttributeFontColor #4C1D95
}

class Cell {
  +id         : string
  +answer     : string
  +letter     : string
  +isBlock    : boolean
  +number     : number
}

class Clue {
  +number     : number
  +direction  : row or col
  +text       : string
  +answer     : string
  +row        : number
  +col        : number
}

class HookState {
  +grid           : Cell[][]
  +activeCell     : row, col
  +direction      : row or col
  +isCompleted    : boolean
  +hintsLeft      : number
  +hintedCells    : Set
  +elapsedSeconds : number
  +timerStarted   : boolean
}

class "Grid 9x10" as Grid {
  MODELO  : row=0, col=0
  DADOS   : row=0, col=2
  PROMPT  : row=2, col=3
  REDE    : row=2, col=4
  TOKEN   : row=3, col=1
  NEURAL  : row=3, col=5
  TREINO  : row=6, col=4
  BIAS    : row=7, col=3
}

HookState "1" *-- "90" Cell : grid[][]
Clue      "8" -->  Grid     : define posicoes
Grid      "1" .>  HookState : popula estado inicial

@enduml
